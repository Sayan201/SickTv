<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Ambient subtle glass contour -->
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#20FFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <!-- Artefact-style acrylic dark glass body (~45% opacity, neutral transparent) -->
    <item android:top="1dp" android:bottom="1dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#660B0C22"
                android:centerColor="#730C0D26"
                android:endColor="#8008081A" />
            <corners android:radius="23dp" />
        </shape>
    </item>
    <!-- Specular top reflection sheen -->
    <item android:top="1dp" android:bottom="1dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#45FFFFFF"
                android:centerColor="#0DFFFFFF"
                android:endColor="#00FFFFFF" />
            <corners android:radius="23dp" />
        </shape>
    </item>
    <!-- Crisp luminous white glass rim -->
    <item android:top="1dp" android:bottom="1dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <stroke android:width="1.2dp" android:color="#4DFFFFFF" />
            <corners android:radius="23dp" />
        </shape>
    </item>
</layer-list>
