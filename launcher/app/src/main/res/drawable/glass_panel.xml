<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Ambient outer edge glow -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1400E5FF" />
            <stroke android:width="2dp" android:color="#2600E5FF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <!-- Translucent obsidian liquid glass body (~75-80% opacity) -->
    <item android:top="1dp" android:bottom="1dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#CC141A29"
                android:centerColor="#D40E1322"
                android:endColor="#DE080B14" />
            <corners android:radius="23dp" />
        </shape>
    </item>
    <!-- Top specular reflection sheen -->
    <item android:top="1dp" android:bottom="1dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#38FFFFFF"
                android:centerColor="#0AFFFFFF"
                android:endColor="#00FFFFFF" />
            <corners android:radius="23dp" />
        </shape>
    </item>
    <!-- Crisp luminous glass rim -->
    <item android:top="1dp" android:bottom="1dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <stroke android:width="1.2dp" android:color="#59FFFFFF" />
            <corners android:radius="23dp" />
        </shape>
    </item>
</layer-list>
