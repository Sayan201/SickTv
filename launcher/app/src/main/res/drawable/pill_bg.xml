<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item android:top="1dp" android:bottom="1dp" android:left="1dp" android:right="1dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="#4DFFFFFF"
                        android:centerColor="#30FFFFFF"
                        android:endColor="#1CFFFFFF" />
                    <corners android:radius="20dp" />
                </shape>
            </item>
            <item android:top="1dp" android:bottom="1dp" android:left="1dp" android:right="1dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="#40FFFFFF"
                        android:centerColor="#10FFFFFF"
                        android:endColor="#00FFFFFF" />
                    <corners android:radius="20dp" />
                </shape>
            </item>
            <item android:top="1dp" android:bottom="1dp" android:left="1dp" android:right="1dp">
                <shape android:shape="rectangle">
                    <stroke android:width="1.5dp" android:color="#FFFFFFFF" />
                    <corners android:radius="20dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <!-- Reorder button while reorder mode is on (focus is on the tiles then). -->
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#40FFFFFF" />
            <stroke android:width="1.5dp" android:color="#E6FFFFFF" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item android:top="1dp" android:bottom="1dp" android:left="1dp" android:right="1dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="#2EFFFFFF"
                        android:endColor="#14FFFFFF" />
                    <stroke android:width="1dp" android:color="#38FFFFFF" />
                    <corners android:radius="20dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
