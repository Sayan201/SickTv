<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <!-- Luminous electric blue/cyan liquid glass base -->
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="#F00088FF"
                        android:endColor="#F00052D4" />
                    <corners android:radius="13dp" />
                </shape>
            </item>
            <!-- Specular top sheen -->
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="#40FFFFFF"
                        android:centerColor="#08FFFFFF"
                        android:endColor="#00FFFFFF" />
                    <corners android:radius="13dp" />
                </shape>
            </item>
            <!-- Luminous glass rim stroke -->
            <item>
                <shape android:shape="rectangle">
                    <stroke android:width="1.2dp" android:color="#99FFFFFF" />
                    <corners android:radius="13dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#500088FF" />
            <corners android:radius="13dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <corners android:radius="13dp" />
        </shape>
    </item>
</selector>
