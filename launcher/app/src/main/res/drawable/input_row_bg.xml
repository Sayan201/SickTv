<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <!-- Frosted liquid glass lens fill -->
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="#59FFFFFF"
                        android:centerColor="#38FFFFFF"
                        android:endColor="#20FFFFFF" />
                    <corners android:radius="13dp" />
                </shape>
            </item>
            <!-- Top specular reflection sheen -->
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="#99FFFFFF"
                        android:centerColor="#26FFFFFF"
                        android:endColor="#00FFFFFF" />
                    <corners android:radius="13dp" />
                </shape>
            </item>
            <!-- Glowing white rim stroke -->
            <item>
                <shape android:shape="rectangle">
                    <stroke android:width="1.2dp" android:color="#E6FFFFFF" />
                    <corners android:radius="13dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#40FFFFFF" />
            <corners android:radius="13dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <corners android:radius="13dp" />
        </shape>
    </item>
</selector>
