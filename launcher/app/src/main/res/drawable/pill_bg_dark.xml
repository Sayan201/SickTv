<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="#59FFFFFF"
                        android:centerColor="#38FFFFFF"
                        android:endColor="#20FFFFFF" />
                    <corners android:radius="21dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="#99FFFFFF"
                        android:centerColor="#26FFFFFF"
                        android:endColor="#00FFFFFF" />
                    <corners android:radius="21dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <stroke android:width="1.5dp" android:color="#FFFFFFFF" />
                    <corners android:radius="21dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <!-- Reorder button while reorder mode is on (focus is on the tiles then). -->
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#40FFFFFF" />
            <stroke android:width="1.5dp" android:color="#E6FFFFFF" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#2B000000"
                android:endColor="#14000000" />
            <stroke android:width="1dp" android:color="#33000000" />
            <corners android:radius="21dp" />
        </shape>
    </item>
</selector>
